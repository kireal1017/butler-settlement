# ─────────────────────────────────────────────────────────────
# 버틀러 — 외부 연동 키
#
# 이 파일을 server/.env 로 복사해서 값을 채우세요.
#   cp server/.env.example server/.env
#
# .env 는 .gitignore 에 있습니다. 키를 커밋하지 마세요.
# 값이 비어 있으면 자동으로 픽스처·시드 모드로 돌아갑니다 (전 구간 동작).
# 확인:  npm run check-env
# ─────────────────────────────────────────────────────────────


# ═══ 1. K-apt (공동주택관리정보시스템) ════════════════════════
#
# 발급처: https://www.data.go.kr
#
# ── 넣을 값 ──────────────────────────────────────────────────
# 마이페이지 → 오픈API → 인증키 발급현황 → **일반 인증키 (Decoding)**
#
#   ⚠ Encoding 키가 아니라 Decoding 키입니다.
#     Encoding 키는 %2B · %2F · %3D 처럼 % 가 보이는 쪽입니다. 그대로 넣으면
#     요청할 때 % 가 %25 로 한 번 더 인코딩되어 인증이 깨집니다.
#     (실수해도 코드가 한 번 풀어 주지만, Decoding 키가 정석입니다)
#
#   ⚠ 인증키는 **계정당 1개**입니다. API 마다 키가 따로 나오지 않습니다.
#     그래서 이 변수도 하나뿐입니다. API 별로 다른 것은 "활용신청" 뿐입니다.
#
# ── 활용신청이 필요한 API 3개 (전부 "승인" 이어야 합니다) ─────
#
#   ① 국토교통부_공동주택 단지 목록제공 서비스
#      https://www.data.go.kr/data/15057332/openapi.do
#      → 전국 단지 코드·단지명       (AptListService4/getTotalAptList4)
#
#   ② 국토교통부_공동주택관리비(장기수선충당금)정보서비스
#      https://www.data.go.kr/data/15059160/openapi.do
#      → 단지별 월부과액(sLevy)      (AptRepairsCostServiceV3/getHsmpMonthFeeInfoV3)
#
#   ③ 국토교통부_공동주택 기본 정보제공 서비스
#      https://www.data.go.kr/data/15058453/openapi.do
#      → 전용면적합(privArea)        (AptBasisInfoServiceV5/getAphusBassInfoV5)
#        ②가 주는 값은 단지 전체 "총액"이라, 이 면적으로 나눠야 원/㎡ 가 됩니다.
#        ③이 없으면 단가 환산이 불가능해 시드 단가로 남습니다.
#
#   ※ 세 API 는 서로 다른 서비스입니다. 하나만 신청하면 나머지는
#     403(등록되지 않은 서비스키)이 납니다.
#   ※ 개발계정은 자동승인이지만 반영까지 최대 1시간 걸립니다.
#
KAPT_SERVICE_KEY=


# ═══ 2. OCR (등기부 인식) ═════════════════════════════════════
#
# clova | upstage | 비워 두면 픽스처 모드
OCR_PROVIDER=clova

# ── CLOVA OCR ────────────────────────────────────────────────
# 발급처: NCP 콘솔 → Services → AI Services → CLOVA OCR
#
# 순서:  도메인 생성 → [API Gateway 연동] → Secret Key [생성] → [자동 연동]
#        → 연동 완료 후 나오는 두 값을 복사
#
#   OCR_API_KEY   = Secret Key            (요청 헤더 X-OCR-SECRET 로 나갑니다)
#   OCR_ENDPOINT  = APIGW Invoke URL + /general
#
#   형식) https://<고유값>.apigw.ntruss.com/custom/v1/<도메인ID>/<키>/general
#
#   ⚠ 끝에 **/general** 을 붙이세요.
#     General OCR 의 URI 가 POST /general 입니다. 콘솔이 복사해 주는 Invoke URL 은
#     여기까지의 앞부분이라, 그대로 넣으면 404 가 납니다.
#
#   ⚠ http://clovaocr-api-kr.ncloud.com/external/v1/... 를 넣지 마세요.
#     이것은 도메인에 할당되는 **고유 InvokeURL** 로, 공식 문서가 "보안을 위해
#     외부 서비스에 바로 공개되지 않는다" 고 못박은 주소입니다. 사설 IP(10.x)로
#     풀려서 VPC 밖에서는 연결 타임아웃만 납니다. 반드시 API Gateway 를 연동하고
#     apigw.ntruss.com 쪽 주소를 쓰세요.
#
# ── Upstage Document Parse (대안) ────────────────────────────
#   OCR_API_KEY  = API Key
#   OCR_ENDPOINT = https://api.upstage.ai/v1/document-digitization
#
OCR_API_KEY=
OCR_ENDPOINT=


# ═══ 3. 기타 (선택) ═══════════════════════════════════════════
# PORT=3001
# DB_PATH=./butler.db
